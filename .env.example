# HabitFlowAI environment configuration
# Copy to .env and fill in the values. Only the two MongoDB variables are
# required for local development.

# --- Required ---

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017
# Database name. Use a name containing "_test" when running live integration tests.
MONGODB_DB_NAME=habitflow

# --- Optional (local dev) ---

# API server port (default 3001; the Vite dev server proxies /api here)
#PORT=3001

# development | production. Production enforces auth headers and restricts CORS.
#NODE_ENV=development

# Enable the public read-only demo at /?demo=1 (see docs/DEMO_ARCHITECTURE.md)
#PUBLIC_DEMO_ENABLED=true

# Dev-only demo seeding mode (see docs/DEMO_ARCHITECTURE.md)
#DEMO_MODE_ENABLED=true

# Frontend: override the API base URL (default: same origin / Vite proxy)
#VITE_API_BASE_URL=

# --- Production only ---

# Allowed CORS origin for the deployed frontend, e.g. https://your-app.vercel.app
#FRONTEND_ORIGIN=

# Shared secret for the bootstrap admin endpoint
#BOOTSTRAP_ADMIN_KEY=

# Base URL used in password-reset email links (falls back to the request origin)
#APP_BASE_URL=

# Resend API key for transactional email (password reset). When unset, reset
# links are logged to the server console instead — dev works without a key.
#RESEND_API_KEY=
#EMAIL_FROM=

# --- Web Push reminders ---

# Master switch for the push-reminder scheduler and subscription endpoints.
#PUSH_REMINDERS_ENABLED=true

# VAPID keys for Web Push. Generate once with: npx web-push generate-vapid-keys
# WARNING: rotating these keys invalidates every existing device subscription —
# users would have to re-enable notifications. Do not rotate casually.
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
# Contact URI required by push services, e.g. mailto:you@example.com
#VAPID_SUBJECT=

# --- Testing ---

# Set to true AND use a MONGODB_DB_NAME containing "_test" to run tests
# against a real MongoDB instead of mongodb-memory-server.
#ALLOW_LIVE_DB_TESTS=

# NOTE: The Gemini API key for AI features is NOT an env var — it is entered
# in the app's Settings and stored in localStorage only (BYOK).
